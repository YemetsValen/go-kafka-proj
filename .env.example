# Copy to .env for local development; loaded automatically by cmd/server and
# cmd/consumer via godotenv.

HTTP_ADDR=:8080
GRPC_ADDR=:9090
METRICS_ADDR=:9100

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=wildlife.sightings
KAFKA_CONSUMER_GROUP=wildlife-sightings-consumer

DATABASE_URL=postgres://wildlife:wildlife@localhost:5432/wildlife?sslmode=disable

# Auth (uncomment to enable)
# AUTH_JWT_SECRET=devsecret
# AUTH_API_KEYS=dev-key-1,dev-key-2

LOG_LEVEL=info
LOG_FORMAT=json

# Tracing (uncomment to ship spans somewhere)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# OTEL_TRACES_SAMPLER_ARG=1.0
